pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    environment {
        PATH = "${tool 'MAVEN_HOME'}/bin:${env.PATH}"
        MAVEN_OPTS = "-Dmaven.repo.local=$HOME/.m2/repository"
    }

    parameters {
        booleanParam(name: 'ALLURE', defaultValue: false, description: 'Génération du rapport Allure')
        booleanParam(name: 'LANCER_TOUS_LES_TESTS', defaultValue: false, description: 'Lancer tous les tests')
        choice(name: 'TAG', choices: ['@ecommerce', '@brand1'], description: 'Choisir le tag')
        choice(name: 'ENV', choices: ['dev', 'e2e'], description: 'Environnement')
    }

    stages {

        stage('Préparation workspace') {
            steps {
                sh '''
                    echo "Clean léger workspace..."
                    rm -rf allure-results || true
                    mkdir -p allure-results
                '''
            }
        }

        stage('Lancer tests Karate') {
            steps {
                script {

                    def mvnCmd

                    if (params.LANCER_TOUS_LES_TESTS) {
                        echo "Lancement de tous les tests"
                        mvnCmd = "mvn test -U -Dkarate.env=${params.ENV}"
                    } else {
                        echo "Lancement tag : ${params.TAG}"
                        mvnCmd = "mvn test -U -Dkarate.env=${params.ENV} -Dkarate.options=--tags=${params.TAG}"
                    }

                    retry(2) {
                        sh mvnCmd
                    }
                }
            }
        }
    }

    post {

        always {
            script {
                if (params.ALLURE) {

                    sh '''
                        if [ -d allure-results ]; then
                            chmod -R 777 allure-results || true
                            find allure-results -type f -exec touch {} \\;
                        fi
                    '''

                    archiveArtifacts artifacts: 'allure-results/**', fingerprint: true

                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [[path: 'allure-results']]
                    )
                }
            }
        }
    }
}