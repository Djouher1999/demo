pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-17'
            args '-u=root'
        }
    }

    parameters {
        booleanParam(name: 'ALLURE', defaultValue: false, description: 'Génération du rapport Allure')
        booleanParam(name: 'LANCER_TOUS_LES_TESTS', defaultValue: false, description: 'Cocher pour lancer tous les tests')
        choice(name: 'TAG', choices: ['@ecommerce','@brand1'], description: 'Choisir le tag à lancer')
    }

    stages {

        stage('Nettoyer Allure Results') {
            steps {
                sh '''
                    echo "Suppression du cache Allure..."
                    rm -rf allure-results
                    mkdir -p allure-results
                    echo "Dossier allure-results nettoyé avec succès"
                '''
            }
        }

        stage('Lancer les tests Karate') {
            steps {
                script {
                    if (params.LANCER_TOUS_LES_TESTS) {
                        echo "Lancement de TOUS les tests..."
                        sh 'mvn test'
                    } else {
                        echo "Lancement du tag : ${params.TAG}"
                        sh "mvn test -Dkarate.options='--tags ${params.TAG}'"
                    }
                    if (params.ALLURE) {
                        stash name: 'allure-results', includes: 'allure-results/*'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (params.ALLURE) {
                    unstash 'allure-results'
                    archiveArtifacts 'allure-results/*'
                    allure includeProperties: false,
                           jdk: '',
                           results: [[path: 'allure-results/']]
                }
            }
        }
    }
}