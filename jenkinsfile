pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'
    }

    environment {
        PATH = "${tool 'MAVEN_HOME'}/bin:${env.PATH}"
    }

    parameters {
        booleanParam(name: 'ALLURE', defaultValue: false)
        booleanParam(name: 'LANCER_TOUS_LES_TESTS', defaultValue: false)
        choice(name: 'TAG', choices: ['@ecommerce', '@brand1'])
    }

    stages {

        stage('Nettoyer Allure Results') {
            steps {
                sh '''
                    rm -rf allure-results
                    mkdir -p allure-results
                '''
            }
        }

        stage('Lancer les tests Karate') {
            steps {
                script {
                    if (params.LANCER_TOUS_LES_TESTS) {
                        sh 'mvn test'
                    } else {
                        echo "Lancement du tag : ${params.TAG}"
                        sh "mvn test -Dkarate.options=--tags=${params.TAG}"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (params.ALLURE) {

                    sh '''
                        if [ -d allure-results ]; then
                            chmod -R 777 allure-results || true
                            find allure-results -type f -exec touch {} \\;
                        fi
                    '''

                    archiveArtifacts artifacts: 'allure-results/**', fingerprint: true

                    allure(
                        includeProperties: false,
                        jdk: '',
                        results: [[path: 'allure-results']]
                    )
                }
            }
        }
    }
}